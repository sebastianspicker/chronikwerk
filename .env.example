# ===========================================================================
# zammad-pdf-archiver -- Environment Configuration
# ===========================================================================
#
# Copy this file to `.env` and adjust values. Do NOT commit secrets.
#
# Precedence: environment > YAML (CONFIG_PATH) > defaults
# Full reference: docs/config-reference.md
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED -- You must set these for the service to start
# ---------------------------------------------------------------------------

# Zammad instance URL and API token
ZAMMAD_BASE_URL=https://zammad.example.local
ZAMMAD_API_TOKEN=change-me

# Root directory where PDFs and sidecar JSON files are written.
# In production, this is typically a CIFS/SMB mount (see scripts/ops/mount-cifs.sh).
STORAGE_ROOT=/mnt/archive

# Webhook HMAC secret -- must match the secret configured in Zammad's webhook.
# When set, POST /ingest requires X-Hub-Signature: sha1=<hex> or sha256=<hex>.
WEBHOOK_HMAC_SECRET=change-me

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Optional YAML config path (alternative to env vars)
# CONFIG_PATH=./config/config.yaml

# ---------------------------------------------------------------------------
# Logging & Observability
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
# LOG_FORMAT=human                # human | json
# METRICS_ENABLED=false           # expose /metrics endpoint
# METRICS_BEARER_TOKEN=           # protect /metrics with Bearer auth

# ---------------------------------------------------------------------------
# Webhook Authentication
# ---------------------------------------------------------------------------

# Legacy fallback (use WEBHOOK_HMAC_SECRET instead)
# WEBHOOK_SHARED_SECRET=change-me

# Allow unsigned webhooks (TESTING ONLY -- do not use in production)
# HARDENING_WEBHOOK_ALLOW_UNSIGNED=true

# Require X-Zammad-Delivery header on /ingest
# HARDENING_WEBHOOK_REQUIRE_DELIVERY_ID=true

# ---------------------------------------------------------------------------
# Workflow & Processing
# ---------------------------------------------------------------------------

# WORKFLOW_TRIGGER_TAG=pdf:sign           # tag that triggers archiving
# WORKFLOW_REQUIRE_TAG=true               # skip tickets without trigger tag
# WORKFLOW_EXECUTION_BACKEND=inprocess    # inprocess | redis_queue
# IDEMPOTENCY_BACKEND=memory             # memory | redis

# Redis (required when execution_backend=redis_queue or idempotency_backend=redis)
# REDIS_URL=redis://localhost:6379/0

# Queue tuning (redis_queue backend only)
# WORKFLOW_QUEUE_STREAM=zammad:jobs
# WORKFLOW_QUEUE_GROUP=zammad:jobs:workers
# WORKFLOW_QUEUE_CONSUMER=
# WORKFLOW_QUEUE_READ_BLOCK_MS=1000
# WORKFLOW_QUEUE_READ_COUNT=10
# WORKFLOW_QUEUE_RETRY_MAX_ATTEMPTS=3
# WORKFLOW_QUEUE_RETRY_BACKOFF_SECONDS=2.0
# WORKFLOW_QUEUE_DLQ_STREAM=zammad:jobs:dlq
# WORKFLOW_HISTORY_STREAM=zammad:jobs:history
# WORKFLOW_HISTORY_RETENTION_MAXLEN=5000

# ---------------------------------------------------------------------------
# Zammad Custom Field Names
# ---------------------------------------------------------------------------

# FIELDS_ARCHIVE_PATH=archive_path
# FIELDS_ARCHIVE_USER_MODE=archive_user_mode
# FIELDS_ARCHIVE_USER=archive_user

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# STORAGE_ATOMIC_WRITE=true       # atomic temp-file + rename
# STORAGE_FSYNC=true              # fsync after write

# ---------------------------------------------------------------------------
# Ingress Hardening
# ---------------------------------------------------------------------------

# MAX_BODY_BYTES=1048576           # max webhook body size (1 MB)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RPS=5
# RATE_LIMIT_BURST=10

# ---------------------------------------------------------------------------
# Egress Transport Hardening
# ---------------------------------------------------------------------------

# HARDENING_TRANSPORT_TRUST_ENV=false
# HARDENING_TRANSPORT_ALLOW_LOCAL_UPSTREAMS=false
# HARDENING_TRANSPORT_ALLOW_INSECURE_HTTP=false
# HARDENING_TRANSPORT_ALLOW_INSECURE_TLS=false

# ---------------------------------------------------------------------------
# PDF Rendering
# ---------------------------------------------------------------------------

PDF_TEMPLATE_VARIANT=default              # default | minimal | compact
PDF_LOCALE=de_DE
PDF_TIMEZONE=Europe/Berlin
# PDF_MAX_ARTICLES=250                    # 0 disables limit
# TEMPLATES_ROOT=/opt/zammad-pdf-archiver/templates  # custom template directory

# ---------------------------------------------------------------------------
# Digital Signing (optional)
# ---------------------------------------------------------------------------

SIGNING_ENABLED=false
SIGNING_PFX_PATH=/run/secrets/signing.pfx
SIGNING_PFX_PASSWORD=
# SIGNING_REASON=Ticket Archivierung
# SIGNING_LOCATION=Datacenter

# ---------------------------------------------------------------------------
# RFC 3161 Timestamping (optional, requires signing)
# ---------------------------------------------------------------------------

# TSA_ENABLED=false
# TSA_URL=https://tsa.example.local/rfc3161
# TSA_TIMEOUT_SECONDS=10
# TSA_CA_BUNDLE_PATH=/etc/ssl/certs/tsa-ca.pem
# TSA_USER=
# TSA_PASS=

# ---------------------------------------------------------------------------
# CIFS/SMB Mount Helper (scripts/ops/mount-cifs.sh)
# ---------------------------------------------------------------------------

# CIFS_REMOTE=//fileserver.example.local/share
# CIFS_MOUNTPOINT=/mnt/archive
# CIFS_USERNAME=archive-user
# CIFS_PASSWORD=change-me
# CIFS_DOMAIN=EXAMPLE

# ---------------------------------------------------------------------------
# Admin Dashboard & API (optional)
# ---------------------------------------------------------------------------

# ADMIN_ENABLED=false
# ADMIN_BEARER_TOKEN=change-me
# ADMIN_HISTORY_LIMIT=100
