# ===========================================================================
# Chronikwerk environment configuration
# ===========================================================================
#
# Copy this file to `.env` and adjust values. Do NOT commit secrets.
#
# Precedence: environment > managed overlay > YAML > dotenv > file secrets > defaults
# Full reference: docs/config-reference.md
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED -- You must set these for the service to start
# ---------------------------------------------------------------------------

# Zammad instance URL and API token
ZAMMAD__BASE_URL=https://zammad.example.local
ZAMMAD__API_TOKEN=change-me

# Root directory where PDFs and sidecar JSON files are written.
# In production, this is typically a host-managed CIFS/SMB mount.
STORAGE__ROOT=/mnt/archive

# Webhook HMAC secret -- must match the secret configured in Zammad's webhook.
# POST /ingest requires X-Hub-Signature: sha256=<hex>.
ZAMMAD__WEBHOOK_HMAC_SECRET=change-me

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

SERVER__HOST=0.0.0.0
SERVER__PORT=8080

# Optional YAML config path (alternative to env vars)
# CONFIG_PATH=./config/config.yaml

# ---------------------------------------------------------------------------
# Logging & Observability
# ---------------------------------------------------------------------------

OBSERVABILITY__LOG_LEVEL=INFO
# OBSERVABILITY__LOG_FORMAT=human
# OBSERVABILITY__METRICS_ENABLED=false
# OBSERVABILITY__METRICS_BEARER_TOKEN=
# OBSERVABILITY__HISTORY_ENABLED=false
# OBSERVABILITY__HISTORY_BEARER_TOKEN=
# OBSERVABILITY__HEALTHZ_OMIT_VERSION=false

# ---------------------------------------------------------------------------
# Webhook Authentication
# ---------------------------------------------------------------------------

# Require X-Zammad-Delivery header on /ingest
# HARDENING__WEBHOOK__REQUIRE_DELIVERY_ID=true

# ---------------------------------------------------------------------------
# Workflow & Processing
# ---------------------------------------------------------------------------

# WORKFLOW__TRIGGER_TAG=pdf:sign
# WORKFLOW__REQUIRE_TAG=true
# WORKFLOW__ACKNOWLEDGE_ON_SUCCESS=true
# WORKFLOW__DELIVERY_ID_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Zammad Custom Field Names
# ---------------------------------------------------------------------------

# FIELDS__ARCHIVE_PATH=archive_path
# FIELDS__ARCHIVE_USER_MODE=archive_user_mode
# FIELDS__ARCHIVE_USER=archive_user

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# STORAGE__FSYNC=true
# STORAGE__FILENAME_PATTERN=Ticket-{ticket_number}_{timestamp_utc}.pdf

# ---------------------------------------------------------------------------
# Ingress Hardening
# ---------------------------------------------------------------------------

# HARDENING__BODY_SIZE_LIMIT__MAX_BYTES=1048576
# HARDENING__RATE_LIMIT__ENABLED=true
# HARDENING__RATE_LIMIT__RPS=5
# HARDENING__RATE_LIMIT__BURST=10
# HARDENING__RATE_LIMIT__INCLUDE_METRICS=false
# HARDENING__RATE_LIMIT__CLIENT_KEY_HEADER=
# ADMISSION__MAX_PENDING=100
# ADMISSION__MAX_RUNNING=4
# ADMISSION__SHUTDOWN_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Egress Transport Hardening
# ---------------------------------------------------------------------------

# HARDENING__TRANSPORT__TRUST_ENV=false
# HARDENING__TRANSPORT__ALLOW_INSECURE_HTTP=false
# HARDENING__TRANSPORT__ALLOW_PRIVATE_NETWORKS=false

# ---------------------------------------------------------------------------
# PDF Rendering
# ---------------------------------------------------------------------------

PDF__LOCALE=de-DE
PDF__TIMEZONE=Europe/Berlin
# PDF__MAX_ARTICLES=250
# PDF__ARTICLE_LIMIT_MODE=fail

# ---------------------------------------------------------------------------
# Digital Signing (optional)
# ---------------------------------------------------------------------------

SIGNING__ENABLED=false
SIGNING__PFX_PATH=/run/secrets/signing.pfx
SIGNING__PFX_PASSWORD=
# SIGNING__PADES__REASON=Ticket Archivierung
# SIGNING__PADES__LOCATION=Datacenter

# ---------------------------------------------------------------------------
# RFC 3161 Timestamping (optional, requires signing)
# ---------------------------------------------------------------------------

# SIGNING__TIMESTAMP__ENABLED=false
# SIGNING__TIMESTAMP__RFC3161__TSA_URL=https://tsa.example.local/rfc3161
# SIGNING__TIMESTAMP__RFC3161__TIMEOUT_SECONDS=10
# SIGNING__TIMESTAMP__RFC3161__CA_BUNDLE_PATH=/etc/ssl/certs/tsa-ca.pem
# SIGNING__TIMESTAMP__RFC3161__USER=
# SIGNING__TIMESTAMP__RFC3161__PASSWORD=

# Bearer token for POST /retry/{ticket_id}
# RETRY_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Administration application (optional, disabled by default)
# ---------------------------------------------------------------------------

# ADMIN__ENABLED=false
# ADMIN__ACCESS_TOKEN=change-me-at-least-32-characters
# ADMIN__STATE_DIR=/var/lib/chronikwerk/admin
# ADMIN__SESSION_IDLE_SECONDS=1800
# ADMIN__SESSION_ABSOLUTE_SECONDS=28800
# ADMIN__COOKIE_SECURE=true
# ADMIN__DEFAULT_LOCALE=de-DE
