# Example environment for zammad-pdf-archiver.
# Copy to a private deployment-specific file and replace every CHANGE-ME value.
# Do not commit real secrets.

# Optional YAML configuration. Leave empty unless the file exists in the runtime.
CONFIG_PATH=

SERVER__HOST=0.0.0.0
SERVER__PORT=8080

ZAMMAD__BASE_URL=https://zammad.example.local
ZAMMAD__API_TOKEN=CHANGE-ME
ZAMMAD__WEBHOOK_HMAC_SECRET=CHANGE-ME-TO-A-RANDOM-32-BYTE-SECRET

STORAGE__ROOT=/mnt/archive
