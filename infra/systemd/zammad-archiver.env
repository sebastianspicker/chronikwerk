# Example environment file for systemd.
# Install to: /etc/zammad-archiver/zammad-archiver.env
# Do not store secrets in world-readable locations.

# Used by the systemd unit to locate the env file for docker compose.
ARCHIVER_ENV_FILE=/etc/zammad-archiver/zammad-archiver.env

OBSERVABILITY__LOG_LEVEL=INFO
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
# Optional YAML config file path.
# Leave unset unless you create the file (e.g. under /opt/zammad-ticket-archiver/config/config.yaml).
# CONFIG_PATH=./config/config.yaml
STORAGE__ROOT=/mnt/archive

# Administration application (disabled until all release gates pass)
# ADMIN__ENABLED=false
# ADMIN__ACCESS_TOKEN=CHANGE-ME-AT-LEAST-32-CHARACTERS
# ADMIN__STATE_DIR=/var/lib/zammad-pdf-archiver/admin
# ADMIN__COOKIE_SECURE=true

# Zammad (required)
ZAMMAD__BASE_URL=https://zammad.example.local
ZAMMAD__API_TOKEN=CHANGE-ME

# Webhook auth (required unless you explicitly enable unsigned mode for internal/test use)
# ZAMMAD__WEBHOOK_HMAC_SECRET=CHANGE-ME

# Signing material (optional)
# SIGNING__ENABLED=true
# SIGNING__PFX_PATH=/run/secrets/signing.pfx
# SIGNING__PFX_PASSWORD=CHANGE-ME
